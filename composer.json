{
	"name": "estasofttechnologies/estasoft-handover-passport",
	"description": "A living record of a WordPress site (stack, licences, domains, backups, restore steps, owners) that exports as a client-ready handover pack.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://estasoft.com",
	"authors": [
		{
			"name": "ESTASOFT TECHNOLOGIES",
			"homepage": "https://estasoft.com"
		}
	],
	"require": {
		"php": ">=8.1",
		"ext-json": "*",
		"ext-mbstring": "*"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"autoload": {
		"psr-4": {
			"Estasoft\\HandoverPassport\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Estasoft\\HandoverPassport\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
		"cs": "phpcs",
		"cbf": "phpcbf",
		"test": "phpunit"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
